  (global_label "GRN4_A" (shape passive) (at 336.55 247.65 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left)) (uuid 36be3a27-eab2-492b-b3d3-640b9da7738f) (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 336.55 247.65 0) (effects (font (size 1.27 1.27)) hide)))
  (text "sa400_led_monitor  v0.2.4  -  SA400 form-factor drive-select / write-gate LED monitor" (at 20 20 0) (effects (font (size 3 3)) (justify left bottom)) (uuid 6e88546d-d90b-4fb9-88f9-7dd0474525ae))
  (text "Shugart bus signals are active-low, open-collector, terminated (150R) at the LAST DRIVE. This board is a high-impedance tap: 74LS14 inputs plus 10k pull-ups only." (at 20 28 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 787b31f1-6b94-4a13-ac41-03c525e20c11))
  (text "U1 74LS14 inverts the bus: DSn and WG are HIGH when the line is asserted.  U3 74LS06 (open collector) sinks the RED LED when DSn is high.  U2 74LS00 sinks the GREEN LED when DSn AND WG are both high." (at 20 33 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid f77ff8ba-eed7-4435-865b-36caa017a01f))
  (text "LED current = (5 - 0.4 - Vf) / 470R  ~ 5.5 mA with a 2.0 V standard LED (within the 74LS00 8 mA sink).  High-efficiency LEDs: use 1k5 (~1.8 mA)." (at 20 38 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 66cab594-b29e-4830-ac66-4892c5efea24))
  (text "Power (as the SA400): J2-4 +5 V -> F1 PTC -> Q1 P-MOSFET reverse switch -> +5V [D11 5.6 V clamp, C6, C4] -> logic. J2-1 +12 V lights D12 only (R19 2k2, ~4.5 mA).  D13 shows the +5 V rail.  Bus lines pass through 470R (R14-R18) before the pull-ups and 74LS14." (at 20 43 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 91eeff53-4640-444f-a568-00f56ecfab64))
  (text "Unused gate inputs tied to GND; unused outputs left open.  Net names: XXX_n = bus finger (active-low), XXX_in = after the series resistor, XXX = inverted." (at 20 48 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid e75c4e8f-080e-40ae-b348-14dd2727d66a))
  (text "LED chains: +5V - R - LED anode ; LED cathode - gate output (sinks when active)" (at 190 190 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid 6886738e-34c5-465a-a2bf-74382264364c))
  (sheet_instances (path "/" (page "1")))
)
